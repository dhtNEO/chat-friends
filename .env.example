# Copie somente para personalizar. scripts/up.sh gera credenciais locais se .env não existir.
POSTGRES_USER=friends
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
LIVEKIT_API_KEY=SUBSTITUA_POR_CHAVE_UNICA
LIVEKIT_API_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_32_BYTES
SPACE_NAME=Entre amigos
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
LIVEKIT_PUBLIC_URL=ws://localhost:8080
LIVEKIT_NODE_IP=127.0.0.1
SCREEN_BITRATE=4000000
SCREEN_HEIGHT=720
SCREEN_FPS=30
# Internet/LAN com HTTPS: edite APP_ORIGIN, COOKIE_SECURE e LIVEKIT_PUBLIC_URL.
APP_DOMAIN=amigos.example.com
MEDIA_DOMAIN=midia.example.com
ACME_EMAIL=voce@example.com

# TURN opcional; CHAT_TURN=true requer certificado em generated/turn-certs.
TURN_DOMAIN=turn.example.com
