# Modos: CHAT_MODE=dev (padrão) ou CHAT_MODE=prd nos comandos; não definir CHAT_MODE neste arquivo.
# Copie somente para personalizar. scripts/up.sh gera credenciais locais se .env não existir.
# Conta do operador/DBA: nunca entregue ao backend de runtime.
# configure.sh gera credenciais separadas e chave MFA em generated/runtime.env.
POSTGRES_USER=friends
POSTGRES_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
LIVEKIT_API_KEY=SUBSTITUA_POR_CHAVE_UNICA
LIVEKIT_API_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_32_BYTES
SPACE_NAME=Entre amigos
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:8080
LIVEKIT_NODE_IP=127.0.0.1
SCREEN_BITRATE=8000000
SCREEN_HEIGHT=1080
SCREEN_FPS=30
# prd com HTTPS: edite APP_ORIGIN, COOKIE_SECURE e LIVEKIT_PUBLIC_URL.
APP_DOMAIN=amigos.example.com
MEDIA_DOMAIN=midia.example.com
ACME_EMAIL=voce@example.com

# TURN opcional; CHAT_TURN=true requer certificado em generated/turn-certs.
TURN_DOMAIN=turn.example.com

# DuckDNS: scripts/duckdns-init.sh salva token privado em generated/duckdns/token.
# Não adicionar token aqui. Ativação: CHAT_MODE=prd ./scripts/up.sh.

# Porta pública do roteador; DuckDNS usa 18443 por padrão. Interior Docker: 443.
PUBLIC_HTTPS_PORT=443
