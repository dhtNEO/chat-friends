<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.chatfriends.duckdns</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>__REPO__/scripts/duckdns-update.sh</string></array>
<key>WorkingDirectory</key><string>__REPO__</string>
<key>EnvironmentVariables</key><dict><key>DUCKDNS_DOCKER_BIN</key><string>__DOCKER__</string></dict>
<key>StartInterval</key><integer>300</integer>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>__REPO__/infra/compose/generated/duckdns/launchagent.log</string>
<key>StandardErrorPath</key><string>__REPO__/infra/compose/generated/duckdns/launchagent.log</string>
</dict></plist>
