{
 admin off
}
:8080 {
 @direct not header X-Chat-Proxy-Key {$APP_PROXY_KEY:disabled}
 request_header @direct X-Chat-Client-IP {http.request.remote.host}
 request_header X-Chat-Proxy-Key {$APP_PROXY_KEY:disabled}
 root * /srv
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy same-origin
  Permissions-Policy "camera=(), microphone=(self), display-capture=(self)"
  Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' {$MEDIA_CONNECT_SRC:ws: wss:}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
 }
 @signal path /rtc /rtc/*
 handle @signal {
  forward_auth backend:8080 {
   uri /api/livekit/admit
   copy_headers X-Media-Authorization
  }
  reverse_proxy livekit:7880 {
   header_up Authorization {http.request.header.X-Media-Authorization}
   header_up -X-Media-Authorization
  }
 }
 @backend path /api/* /ws
 handle @backend {
  request_body {
   max_size 16KB
  }
  reverse_proxy backend:8080
 }
 handle {
  try_files {path} /index.html
  file_server
 }
}
